# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel under Project → Settings → Environment Variables.
#
# Both are required for the RSVP form to save anything. Without them the
# site still runs, but submitting an RSVP shows an error telling the guest
# to text you instead. See SETUP.md step 3 for where these come from.

# --- RSVP → Google Sheet -------------------------------------------------
# The "Web app" URL you get after deploying scripts/rsvp-sheet.gs from your
# spreadsheet. It ends in /exec — the /dev URL will NOT work for guests.
RSVP_SHEET_WEBHOOK_URL=

# Any random string. Must match SHARED_SECRET at the top of the Apps Script
# exactly, or the script will reject every submission.
RSVP_SHARED_SECRET=change-me-to-something-random

# --- Gift fund → Google Sheet -------------------------------------------
# A SECOND spreadsheet and a SECOND deployment, separate from the RSVP one.
# Without these the fund still renders — every total just sits at $0 and
# "Chip in" tells the guest to text you. See SETUP.md step 5.

# The "Web app" URL from deploying scripts/gift-fund-sheet.gs. Ends in /exec.
GIFT_FUND_SHEET_WEBHOOK_URL=

# Must match SHARED_SECRET at the top of scripts/gift-fund-sheet.gs.
# Use a different random string from the RSVP one.
GIFT_FUND_SHARED_SECRET=change-me-to-something-random

# The passphrase that unlocks /gifts/admin, where you delete a contribution
# someone logged wrong. Only you ever type this. Leave it blank and the
# admin page stays locked for everybody, including you.
GIFT_FUND_ADMIN_PASSWORD=

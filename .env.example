# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel under Project → Settings → Environment Variables.
#
# Both are required for the RSVP form to save anything. Without them the
# site still runs, but submitting an RSVP shows an error telling the guest
# to text you instead. See SETUP.md step 3 for where these come from.

# --- RSVP → Google Sheet -------------------------------------------------
# The "Web app" URL you get after deploying scripts/rsvp-sheet.gs from your
# spreadsheet. It ends in /exec — the /dev URL will NOT work for guests.
RSVP_SHEET_WEBHOOK_URL=

# Any random string. Must match SHARED_SECRET at the top of the Apps Script
# exactly, or the script will reject every submission.
RSVP_SHARED_SECRET=change-me-to-something-random
